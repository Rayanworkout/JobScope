from datetime import datetime

from airflow.providers.standard.operators.python import PythonOperator

from airflow import DAG


def extract_jobs():
    from job_market.ingestion import extract

    extract.run()


def process_jobs():
    from job_market.ingestion import process

    process.run()


def generate_embeddings():
    from job_market.embeddings import generate

    generate.run()


with DAG(
    dag_id="job_market_pipeline",
    description="Job market data pipeline",
    start_date=datetime(2026, 1, 1),
    schedule="@daily",
    catchup=False,
    tags=["job-market"],
) as dag:
    extract = PythonOperator(
        task_id="extract_jobs",
        python_callable=extract_jobs,
    )

    process = PythonOperator(
        task_id="process_jobs",
        python_callable=process_jobs,
    )

    embeddings = PythonOperator(
        task_id="generate_embeddings",
        python_callable=generate_embeddings,
    )

    extract >> process >> embeddings
